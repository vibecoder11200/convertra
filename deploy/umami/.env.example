# Copy to `.env` (git-ignored) next to docker-compose.yml and fill in real
# values. Never commit the real `.env`.

# openssl rand -hex 32
APP_SECRET=

# openssl rand -hex 16 (or any strong password) — used for the umami DB user
POSTGRES_PASSWORD=

# only needed if enabling 2FA in Umami: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=
